# Copy this file to .env and fill in real values. Never commit .env.

# SQLAlchemy connection string for the app database.
DATABASE_URL=mysql+pymysql://url_shortener_app:CHANGE_ME@127.0.0.1:3306/url_shortener

# Used only by the test suite (tests/conftest.py). Point this at a throwaway database.
TEST_DATABASE_URL=mysql+pymysql://url_shortener_app:CHANGE_ME@127.0.0.1:3306/url_shortener_test

# Base URL used when building the short link in API responses, e.g. http://localhost:8000
BASE_URL=http://localhost:8000

# Number of random characters in an auto-generated short code.
SHORT_CODE_LENGTH=7

# Rate limit for POST /links, per API key.
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
